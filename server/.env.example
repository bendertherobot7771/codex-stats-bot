CODEX_STATS_HOST=0.0.0.0
CODEX_STATS_PORT=8765
CODEX_STATS_DB=/var/lib/codex-stats-bot/codex-stats.sqlite
CODEX_STATS_API_KEY=change-me

# Создайте бота через @BotFather. Оставьте пустым, чтобы запустить только HTTP API.
TELEGRAM_BOT_TOKEN=

# Сначала напишите боту /whoami, затем перечислите разрешённые chat ID через запятую.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_COMPLETIONS=true

